# ---- Окружения и кэши (восстанавливаются, суммарно ~490 МБ) ----
.uv-cache/
code/python/.venv/
.julia/
.mpl/
__pycache__/
*.pyc

# ---- Промежуточные рендеры вёрстки статьи ----
# итоговый набор остаётся в results/preview_final/
results/preview_v[0-9]*/
results/preview_v[0-9][0-9]*/

# ---- Отчёты-распечатки блокнотов (без текстового слоя, ~40 МБ) ----
# файлы остаются на диске, воспроизводятся печатью Pluto в PDF
article/wave*_report*.pdf

# ---- Рендеры PDF для визуальной проверки ----
results/pdf_preview*/

# ---- Тяжёлые данные: в репозиторий идёт только архив ----
# распакованные файлы остаются на диске и в git не попадают;
# целостность архивов проверена по SHA-256 (см. data/manifest.json)
timeseries_full.json
data/raw/pcm_dpc_province.csv

# ---- Служебное ----
.vscode/*.log
*.tmp
Thumbs.db
desktop.ini
